array_var aJSON

int iSize
int iSizeTemp
int iPassed
int iRequirementsMet
int iRequirementsTotal
int iNotify
float fInstalled
float fRequired
array_var aEntry
string_var sType
string_var sFile

Begin Function {aJSON}

	; Common requirements
	AuxStringMapSetFlt "*ReqCheck_dll" "nvse" (GetNVSEVersionFull)

	; Loop
	if eval (iSize = iRequirementsTotal = Ar_Size (aJSON["requirements"])) > 0
		while (iSize -= 1) > -1
			aEntry = aJSON["requirements"][iSize]

			; "Or" checks
			if eval (TypeOf aEntry) == "Array"
				if eval (iSizeTemp = Ar_Size aEntry) > 0
					iPassed = 0
					while (iSizeTemp -= 1) > -1
						if eval (TypeOf aEntry[iSizeTemp]) != "StringMap"
							continue
						endif
						iNotify = (eval Ar_HasKey aEntry[iSizeTemp] "notify" && aEntry[iSizeTemp]["notify"] == 1)
						sType = aEntry[iSizeTemp]["type"]
						if eval (sType) == "nvse"
							fInstalled = AuxStringMapGetFlt "*ReqCheck_dll" "nvse"
							if eval (fRequired = aEntry[iSizeTemp]["version"]) <= fInstalled
								iPassed = 1
								break
							elseif eval iNotify
								AuxStringMapSetFlt "*ReqCheck_dll_Notify" "nvse" (GetMaxOf fRequired (AuxStringMapGetFlt "*ReqCheck_dll_Notify" "nvse"))
							endif
							continue
						else
							sFile = aEntry[iSizeTemp]["file"]
							if eval (sType) == "plugin"
								if eval (fInstalled = AuxStringMapGetFlt "*ReqCheck_File" (sFile)) == 0
									AuxStringMapSetFlt "*ReqCheck_File" (sFile) (fInstalled = 2 - (IsModLoaded (sFile)))
								endif
								if eval fInstalled == 1
									iPassed = 1
									break
								elseif eval iNotify
									AuxStringMapSetFlt "*ReqCheck_File_Notify" (sFile) 1
								endif
								continue
							elseif eval (sType) == "file"
								if eval (fInstalled = AuxStringMapGetFlt "*ReqCheck_File" (sFile)) == 0
									AuxStringMapSetFlt "*ReqCheck_File" (sFile) (fInstalled = 2 - (eval (FileExists (sFile))))
								endif
								if eval fInstalled == 1
									iPassed = 1
									break
								elseif eval iNotify
									AuxStringMapSetFlt "*ReqCheck_File_Notify" (sFile) 2
								endif
								continue
							elseif eval (sType) == "folder"
								if eval (fInstalled = AuxStringMapGetFlt "*ReqCheck_File" (sFile)) == 0
									AuxStringMapSetFlt "*ReqCheck_File" (sFile) (fInstalled = 2 - (eval (FileExists (sFile) 1)))
								endif
								if eval fInstalled == 1
									iPassed = 1
									break
								elseif eval iNotify
									AuxStringMapSetFlt "*ReqCheck_File_Notify" (sFile) 3
								endif
								continue
							elseif eval (sType) == "dll"
								if eval (fInstalled = AuxStringMapGetFlt "*ReqCheck_dll" (sFile)) == 0
									AuxStringMapSetFlt "*ReqCheck_dll" (sFile) (fInstalled = GetPluginVersion (sFile))
								endif
								if eval (fRequired = aEntry[iSizeTemp]["version"]) <= fInstalled
									iPassed = 1
									break
								elseif eval iNotify
									AuxStringMapSetFlt "*ReqCheck_dll_Notify" (sFile) (GetMaxOf fRequired (AuxStringMapGetFlt "*ReqCheck_dll_Notify" (sFile)))
								endif
								continue
							endif
						endif

					loop
					iRequirementsMet += iPassed
				endif

			; "And" checks
			else
				if eval (TypeOf aEntry) != "StringMap"
					continue
				endif
				iNotify = (eval Ar_HasKey aEntry "notify" && aEntry["notify"] == 1)
				sType = aEntry["type"]
				if eval (sType) == "nvse"
					fInstalled = AuxStringMapGetFlt "*ReqCheck_dll" "nvse"
					if eval (fRequired = aEntry["version"]) <= fInstalled
						iRequirementsMet += 1
					elseif eval iNotify
						AuxStringMapSetFlt "*ReqCheck_dll_Notify" "nvse" (GetMaxOf fRequired (AuxStringMapGetFlt "*ReqCheck_dll_Notify" "nvse"))
					endif
					continue
				else
					sFile = aEntry["file"]
					if eval (sType) == "plugin"
						if eval (fInstalled = AuxStringMapGetFlt "*ReqCheck_File" (sFile)) == 0
							AuxStringMapSetFlt "*ReqCheck_File" (sFile) (fInstalled = 2 - (IsModLoaded (sFile)))
						endif
						if eval fInstalled == 1
							iRequirementsMet += 1
						elseif eval iNotify
							AuxStringMapSetFlt "*ReqCheck_File_Notify" (sFile) 1
						endif
						continue
					elseif eval (sType) == "file"
						if eval (fInstalled = AuxStringMapGetFlt "*ReqCheck_File" (sFile)) == 0
							AuxStringMapSetFlt "*ReqCheck_File" (sFile) (fInstalled = 2 - (eval (FileExists (sFile))))
						endif
						if eval fInstalled == 1
							iRequirementsMet += 1
						elseif eval iNotify
							AuxStringMapSetFlt "*ReqCheck_File_Notify" (sFile) 2
						endif
						continue
					elseif eval (sType) == "folder"
						if eval (fInstalled = AuxStringMapGetFlt "*ReqCheck_File" (sFile)) == 0
							AuxStringMapSetFlt "*ReqCheck_File" (sFile) (fInstalled = 2 - (eval (FileExists (sFile) 1)))
						endif
						if eval fInstalled == 1
							iRequirementsMet += 1
						elseif eval iNotify
							AuxStringMapSetFlt "*ReqCheck_File_Notify" (sFile) 3
						endif
						continue
					elseif eval (sType) == "dll"
						if eval (fInstalled = AuxStringMapGetFlt "*ReqCheck_dll" (sFile)) == 0
							AuxStringMapSetFlt "*ReqCheck_dll" (sFile) (fInstalled = GetPluginVersion (sFile))
						endif
						if eval (fRequired = aEntry["version"]) <= fInstalled
							iRequirementsMet += 1
						elseif eval iNotify
							AuxStringMapSetFlt "*ReqCheck_dll_Notify" (sFile) (GetMaxOf fRequired (AuxStringMapGetFlt "*ReqCheck_dll_Notify" (sFile)))
						endif
						continue
					endif
				endif
			endif

		loop
	endif

	; Requirements met
	SetFunctionValue (eval iRequirementsMet == iRequirementsTotal)

	aJSON = aEntry = ar_Null
	sv_Destruct sType sFile

End